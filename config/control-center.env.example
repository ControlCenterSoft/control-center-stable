CC_LISTEN_ADDR=127.0.0.1:8080
CC_ENVIRONMENT=production
CC_LOG_LEVEL=info
CC_DATABASE_URL=postgres://control_center:replace-with-database-password@db.example.invalid:5432/control_center?sslmode=require
CC_BOOTSTRAP_ADMIN_USERNAME=admin
CC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-bootstrap-secret
PGHOST=db.example.invalid
PGPORT=5432
PGDATABASE=control_center
PGUSER=control_center
PGPASSWORD=replace-with-database-password
