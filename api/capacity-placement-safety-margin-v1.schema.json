{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capacity-placement-safety-margin-v1.schema.json",
  "title": "Capacity Placement Safety Margin Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "advice_id",
    "scope_id",
    "minimum_node_reserve_percent",
    "failure_reserve_nodes",
    "fleet_safe",
    "fleet_safe_reserve",
    "action",
    "candidates",
    "advisory_only",
    "placement_authorized",
    "production_mutation"
  ],
  "properties": {
    "schema_version": {"const": "capacity.placement-safety-margin/v1"},
    "envelope_id": {"type": "string", "pattern": "^psm-[0-9a-f]{24}$"},
    "advice_id": {"type": "string", "pattern": "^pa-[0-9a-f]{24}$"},
    "scope_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "minimum_node_reserve_percent": {"type": "number", "minimum": 0, "maximum": 90},
    "failure_reserve_nodes": {"type": "integer", "minimum": 0, "maximum": 16},
    "fleet_safe": {"type": "boolean"},
    "fleet_safe_reserve": {"type": "number"},
    "recommended_node_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "action": {
      "enum": [
        "none",
        "add-role-capacity",
        "move-role",
        "increase-storage",
        "increase-network",
        "adjust-workload-policy",
        "reduce-load",
        "collect-evidence"
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "advisory_only": {"const": true},
    "placement_authorized": {"const": false},
    "production_mutation": {"const": false}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "eligible",
        "reason",
        "workload_safe_reserve",
        "workload_safe_reserve_percent",
        "minimum_required_reserve_percent",
        "workload_margin_above_minimum_percent",
        "bottleneck_metric",
        "bottleneck_target_id",
        "bottleneck_safe_reserve_percent",
        "effective_safety_margin_percent",
        "limiting_dimension",
        "score_band",
        "confidence"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "eligible": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 255},
        "workload_safe_reserve": {"type": "number"},
        "workload_safe_reserve_percent": {"type": "number"},
        "minimum_required_reserve_percent": {"type": "number", "minimum": 0, "maximum": 90},
        "workload_margin_above_minimum_percent": {"type": "number"},
        "bottleneck_metric": {
          "enum": [
            "cpu.utilization",
            "memory.used",
            "storage.used",
            "storage.iops",
            "storage.latency",
            "storage.queue-depth",
            "network.throughput",
            "network.latency",
            "network.packet-loss",
            "database.latency",
            "database.transactions",
            "service.queue-depth"
          ]
        },
        "bottleneck_target_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "bottleneck_safe_reserve_percent": {"type": "number"},
        "effective_safety_margin_percent": {"type": "number"},
        "limiting_dimension": {"enum": ["workload-safe-reserve", "bottleneck-safe-reserve"]},
        "score_band": {"enum": ["blocked", "boundary", "headroom"]},
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "score"],
          "properties": {
            "level": {"enum": ["low", "medium", "high", "certified"]},
            "score": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
